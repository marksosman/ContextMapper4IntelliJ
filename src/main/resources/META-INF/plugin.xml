<idea-plugin>
    <id>io.github.marksosman.dddcontextmapper</id>
    <name>DDDContextMapper</name>
    <vendor email="marksosman@icloud.com" url="https://github.com/marksosman">marksosman</vendor>

    <description><![CDATA[
        <p>This plug-in is editor support for Context Mapper's CML, a DSL for Domain-Driven Design
    context mapping and service decomposition.</p>
    <p>Features:</p>
    <ul>
        <li>Recognizes <code>.cml</code> files</li>
        <li>Syntax highlighting for keywords, strings, constants, and comments</li>
    </ul>
    <p>This is an independent community plugin, not affiliated with the Context Mapper project.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="CML"
            implementationClass="io.github.marksosman.dddcontextmapper.CmlFileType"
            fieldName="INSTANCE"
            language="CML"
            extensions="cml"/>

        <lang.parserDefinition
            language="CML"
            implementationClass="io.github.marksosman.dddcontextmapper.CmlParserDefinition"/>

        <lang.syntaxHighlighterFactory
            language="CML"
            implementationClass="io.github.marksosman.dddcontextmapper.CmlSyntaxHighlighterFactory"/>
    </extensions>
</idea-plugin>
